export PYTHONPATH="$PROJECT_DIR:$PYTHONPATH"

# Ejecutar y registrar logs de depuración
exec "$PROJECT_DIR/venv/bin/python" "$PROJECT_DIR/gui/app_main.py" "$@" > "$LOG_FILE" 2>&1
