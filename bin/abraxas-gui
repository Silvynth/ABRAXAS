#!/usr/bin/env bash
# =====================================================================
#  ❖ ABRAXAS | DESKTOP LAUNCHER WRAPPER
# =====================================================================

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PROJECT_DIR="$DIR"
LOG_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/abraxas"
mkdir -p "$LOG_DIR"
LOG_FILE="$LOG_DIR/abraxas.log"

cd "$PROJECT_DIR" || exit 1
export PYTHONPATH="$PROJECT_DIR:$PYTHONPATH"

if [ -f "$PROJECT_DIR/venv/bin/python" ]; then
    PYTHON_BIN="$PROJECT_DIR/venv/bin/python"
else
    PYTHON_BIN="$(which python3)"
fi

# Ejecutar y registrar logs de depuración
exec "$PYTHON_BIN" "$PROJECT_DIR/gui/app_main.py" "$@" > "$LOG_FILE" 2>&1
