#!/usr/bin/env bash
# =====================================================================
#  ❖ ABRAXAS | DESKTOP LAUNCHER WRAPPER
# =====================================================================

# Resolver la ruta canónica real del script siguiendo enlaces simbólicos (~/.local/bin/abx)
REAL_SCRIPT="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$REAL_SCRIPT")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

LOG_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/abraxas"
mkdir -p "$LOG_DIR"
LOG_FILE="$LOG_DIR/abraxas.log"

cd "$PROJECT_DIR" || exit 1
export PYTHONPATH="$PROJECT_DIR:$PYTHONPATH"

if [ -f "$PROJECT_DIR/venv/bin/python" ]; then
    PYTHON_BIN="$PROJECT_DIR/venv/bin/python"
elif [ -f "$PROJECT_DIR/.venv/bin/python" ]; then
    PYTHON_BIN="$PROJECT_DIR/.venv/bin/python"
else
    PYTHON_BIN="$(which python3)"
fi

# Ejecutar y registrar logs de depuración
exec "$PYTHON_BIN" "$PROJECT_DIR/gui/app_main.py" "$@" > "$LOG_FILE" 2>&1
