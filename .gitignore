# --- Configuración y Secretos Locales del Usuario ---
config.toml
*.local.toml
config.local.toml
secrets.toml
*secret*.toml
keys.toml
*key*.toml
secrets/
.env
.env.*
*.env
*.state
.test/
.sandbox/
scratch/
projects_order.json
preferred_editor.txt

# --- Skills y Prompts de IA Privados del Usuario ---
# Los archivos de prompts personalizados son privados del usuario.
# Solo se versionan las plantillas .example.txt públicas.
skills/*.txt
!skills/*.example.txt

# --- Certificados, Tokens y Claves Criptográficas ---
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
id_rsa*
id_ed25519*
*.token
credentials.json
service_account*.json

# --- Bases de Datos Locales y Volcados ---
*.sqlite
*.sqlite3
*.db
*.sql
*.dump

# --- Cachés, Logs y Archivos de Sesión ---
cache/
logs/
*.log
*.tmp
last_result.txt
current_dir.txt
.cache/

# --- Entornos Virtuales y Bytecode de Python ---
